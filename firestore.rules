rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Fonctions d'aide pour la sécurité
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAny(['email']) && request.auth.token.email.lower() == 'heriniaina.luk@gmail.com') ||
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'ADMIN') ||
        (userDocExists() && getUserData().get('role', 'MEMBRE') == 'ADMIN')
      );
    }

    function hasPermission(permission) {
      return isSignedIn() && (
        isAdmin() ||
        (userDocExists() && 
         getUserData().get('role', 'MEMBRE') == 'MEMBRE_BUREAU' && 
         getUserData().get('permissions', []).hasAny([permission]))
      );
    }

    function isNotSuspended() {
      return isSignedIn() && (
        !userDocExists() ||
        getUserData().get('isSuspended', false) == false
      );
    }

    function isActiveMember() {
      return isSignedIn() && isNotSuspended() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('status', '') == 'active')
      );
    }

    // ==========================================
    // 1. Utilisateurs (users)
    // ==========================================
    match /users/{userId} {
      allow read: if isSignedIn() && (
        isOwner(userId) || 
        (isNotSuspended() && (hasPermission('users.manage') || isAdmin()))
      );
      
      allow create: if isOwner(userId) &&
        (request.resource.data.role == 'MEMBRE' || isAdmin()) &&
        (!request.resource.data.keys().hasAny(['permissions']) || request.resource.data.permissions.size() == 0 || isAdmin());

      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && isNotSuspended() && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'isSuspended']))
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. Membres & Dossiers administratifs (members)
    // ==========================================
    match /members/{userId} {
      allow read: if isSignedIn() && isNotSuspended() && (
        isOwner(userId) || isActiveMember()
      );

      allow create: if isSignedIn() && isNotSuspended() && (
        (isOwner(userId) && request.resource.data.status == 'pending') ||
        isAdmin()
      );

      allow update: if isSignedIn() && isNotSuspended() && (
        isAdmin() ||
        (hasPermission('membership.review') && (request.auth.uid != userId || isAdmin())) ||
        (isOwner(userId) && request.resource.data.status == 'pending') ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reviewedByUserId', 'approvedAt', 'rejectedAt']))
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // 3. Paiements du droit d'adhésion (membershipPayments)
    // ==========================================
    match /membershipPayments/{paymentId} {
      allow read: if isSignedIn() && (
        isOwner(paymentId) || 
        (isNotSuspended() && (hasPermission('payment.verify') || isAdmin()))
      );
      allow create, update: if isSignedIn() && isNotSuspended() && (
        (isOwner(paymentId) && request.resource.data.isVerified == false) ||
        (hasPermission('payment.verify') && (request.auth.uid != resource.data.userId || isAdmin())) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. Configuration des droits d'adhésion (membershipFeeConfigs)
    // ==========================================
    match /membershipFeeConfigs/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==========================================
    // 5. Cotisations mensuelles (dues) & Demandes d'ajustement
    // ==========================================
    match /dues/{dueId} {
      allow read: if isSignedIn() && isNotSuspended() && (
        resource.data.userId == request.auth.uid || isActiveMember()
      );
      allow create: if hasPermission('dues.manage') || isAdmin();
      allow update: if isSignedIn() && isNotSuspended() && (
        (resource.data.userId == request.auth.uid && request.resource.data.status in ['declared', 'pending']) ||
        hasPermission('payment.verify') ||
        hasPermission('dues.manage') ||
        isAdmin()
      );
      allow delete: if hasPermission('dues.manage') || isAdmin();
    }

    match /dueChangeRequests/{requestId} {
      allow read: if isSignedIn() && isNotSuspended() && (
        resource.data.userId == request.auth.uid || hasPermission('dues.manage') || isAdmin()
      );
      allow create: if isSignedIn() && isNotSuspended() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if hasPermission('dues.manage') || isAdmin();
    }

    // ==========================================
    // 6. Comptes financiers & catégories (financialAccounts & financialCategories)
    // ==========================================
    match /financialAccounts/{accountId} {
      allow read: if isActiveMember();
      allow write: if hasPermission('finance.transaction.approve') || hasPermission('payment.verify') || isAdmin();
    }

    match /financialCategories/{catId} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
    }

    // ==========================================
    // 7. Écritures comptables (financialTransactions)
    // ==========================================
    match /financialTransactions/{txId} {
      allow read: if isActiveMember();
      allow create: if hasPermission('finance.transaction.create') || hasPermission('payment.verify') || isAdmin();
      allow update: if hasPermission('finance.transaction.approve') || isAdmin();
      allow delete: if false; // Strictement interdit de supprimer une transaction!
    }

    // ==========================================
    // 8. Événements (events, eventParticipants, eventTransactions)
    // ==========================================
    match /events/{eventId} {
      allow read: if isActiveMember();
      allow create, update: if hasPermission('event.manage') || isAdmin();
      allow delete: if isAdmin();
    }

    match /eventParticipants/{participantId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.userId == request.auth.uid;
      allow delete: if isActiveMember() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /eventTransactions/{txId} {
      allow read: if isActiveMember();
      allow create, update, delete: if hasPermission('event.manage') || isAdmin();
    }

    // ==========================================
    // 9. Prêts et micro-crédits des membres (loans & memberLoans)
    // ==========================================
    match /loans/{loanId} {
      allow read: if isSignedIn() && isNotSuspended() && (
        resource.data.borrowerUserId == request.auth.uid || isActiveMember()
      );
      allow create: if isSignedIn() && isNotSuspended() && (
        request.resource.data.borrowerUserId == request.auth.uid || hasPermission('finance.transaction.create') || isAdmin()
      );
      allow update: if hasPermission('finance.transaction.approve') || hasPermission('payment.verify') || isAdmin();
      allow delete: if isAdmin();

      match /{subcollection}/{subId} {
        allow read, write: if isActiveMember();
      }
    }

    match /memberLoans/{loanId} {
      allow read: if isSignedIn() && isNotSuspended() && (
        resource.data.borrowerUserId == request.auth.uid || isActiveMember()
      );
      allow create: if isSignedIn() && isNotSuspended() && (
        request.resource.data.borrowerUserId == request.auth.uid || hasPermission('finance.transaction.create') || isAdmin()
      );
      allow update: if hasPermission('finance.transaction.approve') || hasPermission('payment.verify') || isAdmin();
      allow delete: if isAdmin();

      match /{subcollection}/{subId} {
        allow read, write: if isActiveMember();
      }
    }

    // ==========================================
    // 10. Collectes de fonds (fundraisingCampaigns & fundraisingContributions)
    // ==========================================
    match /fundraisingCampaigns/{campaignId} {
      allow read: if isActiveMember();
      allow create, update: if hasPermission('fundraising.manage') || isAdmin();
      allow delete: if isAdmin();
    }

    match /fundraisingContributions/{contribId} {
      allow read: if isSignedIn() && isNotSuspended() && (
        resource.data.userId == request.auth.uid || hasPermission('fundraising.manage') || hasPermission('payment.verify') || isAdmin()
      );
      allow create: if isSignedIn() && isNotSuspended() && request.resource.data.userId == request.auth.uid;
      allow update: if (hasPermission('payment.verify') && request.auth.uid != resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /contributionPayments/{paymentId} {
      allow read: if isSignedIn() && isNotSuspended() && (
        resource.data.userId == request.auth.uid || isActiveMember()
      );
      allow create, update: if isSignedIn() && isNotSuspended() && (
        request.resource.data.userId == request.auth.uid || hasPermission('payment.verify') || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 11. Publications officielles (posts)
    // ==========================================
    match /posts/{postId} {
      allow read: if isActiveMember();
      allow create, update: if hasPermission('post.publish') || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 12. Notifications (notifications)
    // ==========================================
    match /notifications/{notifId} {
      allow read: if isSignedIn() && isNotSuspended() && (
        resource.data.recipientUserId == request.auth.uid ||
        resource.data.recipientUserId == 'all'
      );
      allow update: if isSignedIn() && isNotSuspended() && (
        resource.data.recipientUserId == request.auth.uid ||
        resource.data.recipientUserId == 'all'
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readBy']);
      allow create: if isSignedIn() && isNotSuspended();
      allow delete: if isOwner(resource.data.recipientUserId) || isAdmin();
    }

    // ==========================================
    // 13. Messagerie privée (conversations & messages)
    // ==========================================
    match /conversations/{convId} {
      allow read: if isSignedIn() && isNotSuspended() && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && isNotSuspended() && request.resource.data.participantIds.hasAny([request.auth.uid]);
      allow update: if isSignedIn() && isNotSuspended() && resource.data.participantIds.hasAny([request.auth.uid]);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && isNotSuspended();
      allow create: if isSignedIn() && isNotSuspended() && (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'system');
      allow update: if false;
      allow delete: if false;
    }

    // ==========================================
    // 14. Journal d'Audit (auditLogs) - Immuable!
    // ==========================================
    match /auditLogs/{logId} {
      allow read: if hasPermission('audit.view') || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ==========================================
    // 15. Paramètres globaux (appSettings)
    // ==========================================
    match /appSettings/{settingId} {
      allow read: if isSignedIn() || settingId == 'app_version';
      allow write: if isAdmin();
    }
  }
}
