rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'ADMIN';
    }

    // Photos de profil
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Justificatifs de paiement
    match /proofs/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024;
    }

    // Documents d'identité et passeports (très confidentiels)
    match /passports/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024;
    }

    // Médias officiels des actualités et événements
    match /media/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
